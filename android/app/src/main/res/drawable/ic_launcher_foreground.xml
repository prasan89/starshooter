<?xml version="1.0" encoding="utf-8"?>
<!-- Gold/yellow star foreground for Star Shooter launcher icon.
     The safe zone for adaptive icons is the inner 72dp (centered in 108dp),
     so the star is drawn within that area. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Five-pointed star centered at (54,54), outer radius ~32dp, inner radius ~13dp.
         Points computed for a standard 5-point star at 18° rotation (-90° + 18° = top point).
         Outer vertices at angles: -90, -18, 54, 126, 198 degrees
         Inner vertices at angles: -54, 18, 90, 162, 234 degrees -->
    <path
        android:fillColor="#FFD700"
        android:strokeColor="#FFA500"
        android:strokeWidth="1"
        android:pathData="
            M54,22
            L61.27,44.95
            L85.53,44.95
            L66.13,58.54
            L73.4,81.49
            L54,67.9
            L34.6,81.49
            L41.87,58.54
            L22.47,44.95
            L46.73,44.95
            Z"/>

    <!-- Small decorative stars scattered in background -->
    <!-- Top-left small star -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M22,20 L23.3,24 L27.5,24 L24.1,26.5 L25.4,30.5 L22,28 L18.6,30.5 L19.9,26.5 L16.5,24 L20.7,24 Z"
        android:alpha="0.6"/>

    <!-- Top-right small star -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M86,18 L87,21.1 L90.2,21.1 L87.6,23 L88.6,26.1 L86,24.2 L83.4,26.1 L84.4,23 L81.8,21.1 L85,21.1 Z"
        android:alpha="0.5"/>

    <!-- Bottom-left tiny dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,80 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:alpha="0.4"/>

    <!-- Bottom-right tiny dot -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M88,82 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:alpha="0.5"/>
</vector>
